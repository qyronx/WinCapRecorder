<UserControl x:Class="WinCapRecorder.Controls.HotkeyBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             IsTabStop="True"
             Cursor="Hand"
             Background="Transparent">
    <Border x:Name="RootBorder"
            Background="#33FFFFFF"
            BorderBrush="#44FFFFFF"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10,6"
            MinWidth="140"
            Cursor="Hand">
        <TextBlock x:Name="DisplayText"
                   Text="클릭 후 키 입력"
                   Foreground="#F1F2F6"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   IsHitTestVisible="False"/>
    </Border>
</UserControl>
