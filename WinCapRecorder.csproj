<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WinCapRecorder</RootNamespace>
    <AssemblyName>WinCapRecorder</AssemblyName>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <!-- self-contained: 사용자 PC에 .NET 런타임 설치 안 되어 있어도 실행 가능 -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Win32Resource></Win32Resource>

    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Windows Runtime types are supplied by Microsoft.Windows.SDK.NET.
         Do not locally regenerate them with CsWinRT; that causes CS0436
         duplicate-type warnings against Microsoft.Windows.SDK.NET. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.1.6" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
    <PackageReference Include="SharpGen.Runtime" Version="2.2.0-beta" />
    <PackageReference Include="NAudio" Version="3.0.1" />
    <PackageReference Include="NAudio.Wasapi" Version="3.0.1" />
  </ItemGroup>

</Project>
